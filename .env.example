# OpenAI-compatible chat endpoint used by PEAK Assistant and by the judge/advisor.
# LLM_ENDPOINT is the full chat-completions URL; the PEAK base_url is derived from it.
LLM_ENDPOINT=https://<host>/v1/chat/completions
LLM_API_KEY=<your-key>
LLM_MODEL=<model-name>
LLM_TIMEOUT=600
LLM_MAX_TOKENS=16000
