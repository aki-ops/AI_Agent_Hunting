# Copy this file to .env and fill in your own values. NEVER commit .env
# See src/hunting/m2_abduction/provider.py ApiLLMConfig.from_env()

# OpenAI-compatible base URL (no /chat/completions suffix here)
OPENAI_BASE_URL=http://localhost:4000/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=auto

# Universal LLM endpoint (full path, e.g. .../v1/chat/completions or .../v1/messages)
LLM_ENDPOINT=http://localhost:4000/v1/chat/completions
LLM_API_KEY=sk-your-key-here
LLM_MODEL=auto
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4000

# Splunk (optional, only needed for --provider splunk)
# SPLUNK_URL=https://localhost:8089
# SPLUNK_USER=admin
# SPLUNK_PASSWORD=changeme
# SPLUNK_INDEX=botsv1
