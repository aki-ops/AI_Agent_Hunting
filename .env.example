# OpenAI-compatible chat endpoint used by PEAK Assistant and by the judge/advisor.
# LLM_ENDPOINT is the full chat-completions URL; the PEAK base_url is derived from it.
LLM_ENDPOINT=https://<host>/v1/chat/completions
LLM_API_KEY=<your-key>
LLM_MODEL=<model-name>
LLM_TIMEOUT=600
LLM_MAX_TOKENS=16000

# --- optional hardening (all have safe defaults) ---
# Models tried in order after LLM_MODEL keeps failing (comma separated). The switch is sticky for the rest of the run.
# LLM_MODEL_FALLBACKS=model-b,model-c
# Sampling temperature for judge/advisor. 0 = most repeatable; 'none' = provider default.
# Models that reject a temperature are detected and called without it.
# LLM_TEMPERATURE=0
# Minimum seconds between judge/advisor calls (rate-limited free models).
# LLM_MIN_INTERVAL=0

# --- optional, for `main.py plan` (public intel; both are sent only to their own host) ---
# GitHub allows 60 requests/hour without a token; a token without any scope raises that to 5000.
# GITHUB_TOKEN=
# NVD_API_KEY=
